{
  "rules": {
    "rooms": {
      "$roomCode": {
        ".write": "auth != null && (!data.exists() || data.child('meta/hostUid').val() === auth.uid || (data.child('meta/createdAt').isNumber() && data.child('meta/createdAt').val() <= now - 86400000))",
        "meta": {
          ".read": "auth != null",
          ".write": "auth != null"
        },
        "public": {
          ".read": "auth != null",
          ".write": "auth != null"
        },
        "private": {
          "$uid": {
            ".read": "auth.uid === $uid",
            ".write": "auth.uid === $uid || auth.uid === root.child('rooms/'+$roomCode+'/meta/hostUid').val()"
          }
        },
        "rpc": {
          "$uid": {
            ".read": "auth != null",
            "request": {
              ".write": "auth != null"
            },
            "response": {
              ".write": "auth.uid === $uid"
            }
          }
        }
      }
    },
    "roomIndex": {
      ".read": "auth != null",
      "$roomCode": {
        ".write": "auth != null",
        ".validate": "newData.val() === null || newData.isNumber()"
      }
    }
  }
}
